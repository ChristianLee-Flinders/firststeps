{
    "projectId": "first-steps",
    "endpoint": "https://fra.cloud.appwrite.io/v1",
    "projectName": "First Steps",
    "settings": {
        "services": {
            "account": true,
            "avatars": true,
            "databases": true,
            "locale": true,
            "health": true,
            "storage": true,
            "teams": true,
            "users": true,
            "sites": true,
            "functions": true,
            "graphql": true,
            "messaging": true
        },
        "auth": {
            "methods": {
                "jwt": true,
                "phone": true,
                "invites": true,
                "anonymous": true,
                "email-otp": true,
                "magic-url": true,
                "email-password": true
            },
            "security": {
                "duration": 31536000,
                "limit": 0,
                "sessionsLimit": 10,
                "passwordHistory": 0,
                "passwordDictionary": false,
                "personalDataCheck": false,
                "sessionAlerts": false,
                "mockNumbers": []
            }
        }
    },
    "functions": [
        {
            "$id": "695a4bdb00293eb12850",
            "execute": [
                "any"
            ],
            "name": "sync-search-index",
            "enabled": true,
            "logging": true,
            "runtime": "node-22",
            "scopes": [
                "databases.read",
                "databases.write",
                "policies.read",
                "policies.write",
                "archives.read",
                "archives.write",
                "restorations.read",
                "restorations.write",
                "tables.read",
                "collections.read",
                "tables.write",
                "collections.write",
                "columns.read",
                "attributes.read",
                "columns.write",
                "attributes.write",
                "indexes.read",
                "indexes.write",
                "rows.read",
                "documents.read",
                "rows.write",
                "documents.write"
            ],
            "events": [
                "databases.*.tables.staff_profiles.rows.*.create",
                "databases.*.tables.staff_profiles.rows.*.update",
                "databases.*.tables.staff_profiles.rows.*.delete"
            ],
            "schedule": "",
            "timeout": 15,
            "entrypoint": "src/main.js",
            "commands": "npm install",
            "specification": "s-0.5vcpu-512mb",
            "path": "functions/sync-search-index"
        },
        {
            "$id": "695c38ac000b173753ee",
            "name": "sync-org-team",
            "runtime": "node-22",
            "specification": "s-0.5vcpu-512mb",
            "execute": [
                "any"
            ],
            "events": [
                "databases.*.tables.organisations.rows.*.create",
                "databases.*.tables.organisations.rows.*.update",
                "databases.*.tables.organisations.rows.*.delete"
            ],
            "scopes": [
                "users.read"
            ],
            "schedule": "",
            "timeout": 15,
            "enabled": true,
            "logging": true,
            "entrypoint": "src/main.js",
            "commands": "npm install",
            "path": "functions/sync-org-team"
        }
    ],
    "tablesDB": [
        {
            "$id": "nursery-portal",
            "name": "Nursery Portal",
            "enabled": true
        }
    ],
    "tables": [
        {
            "$id": "staff_profiles",
